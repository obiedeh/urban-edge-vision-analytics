# Urban Edge Vision Analytics — runtime environment
# Everything operational (cameras, model, inference cadence) is configured in the
# web UI and stored in SQLite. These variables only locate that store and its key.

# SQLite config/event store (default: store/urbanvision.sqlite, gitignored)
STORE_PATH=store/urbanvision.sqlite

# Fernet key that encrypts camera passwords and API keys at rest. Either a key
# value (URBAN_EDGE_SECRET_KEY) or a 0600 file holding it; the file is created
# on first use. Default: ~/.config/urban-edge/secret.key
# URBAN_EDGE_SECRET_KEY=
# URBAN_EDGE_SECRET_KEY_FILE=~/.config/urban-edge/secret.key

# Set to 0 to start the API without starting cameras (tests, migrations).
URBAN_EDGE_AUTOSTART=1

# Jetson: NVIDIA vLLM container and the directory holding model weights.
# URBAN_EDGE_JETSON_VLLM_IMAGE=ghcr.io/nvidia-ai-iot/vllm:0.14.0-r38.3-arm64-sbsa-cu130-24.04
# URBAN_EDGE_MODELS_DIR=~/models

# Workstation: path to a vllm executable if it is not on PATH.
# VLLM_BIN=

# Edge-to-cloud publisher (off by default; see docs/cloud-architecture.md)
# URBAN_EDGE_CONFIG=configs/local.json
# URBAN_EDGE_CLOUD_ENABLED=false
